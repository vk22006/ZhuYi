{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ZhuYi",
  "version": "1.0.0",
  "identifier": "com.vk22006.zhuyi",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "逐一",
        "width": 1024,
        "height": 720,
        "minWidth": 768,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/logo_32x32.png",
      "icons/logo_128x128.png",
      "icons/logo_128x128@2x.png",
      "icons/logo.icns",
      "icons/logo.ico"
    ]
  }
}